<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minWidth="360dp"
    android:background="@drawable/hm_dialog_wifi_bg"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/tv_pwd_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/hm_wifi_pwd_dialog_title"
        android:textColor="#333333"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_pwd_ssid"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="#666666"
        android:textSize="14sp"
        tools:text="WiFi: TP-LINK_5G" />

    <EditText
        android:id="@+id/et_wifi_password"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/hm_input_bg"
        android:hint="@string/hm_wifi_pwd_hint"
        android:inputType="textPassword"
        android:maxLines="1"
        android:paddingHorizontal="14dp"
        android:textColor="#333333"
        android:textColorHint="#AAAAAA"
        android:textSize="15sp" />

    <CheckBox
        android:id="@+id/cb_show_password"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/hm_wifi_pwd_show"
        android:textColor="#666666"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="end"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_cancel"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/hm_btn_secondary"
            android:minWidth="96dp"
            android:paddingHorizontal="16dp"
            android:singleLine="true"
            android:text="@string/hm_wifi_cancel"
            android:textColor="#666666"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btn_connect"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:background="@drawable/hm_btn_primary"
            android:minWidth="96dp"
            android:paddingHorizontal="16dp"
            android:singleLine="true"
            android:text="@string/hm_wifi_connect"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />
    </LinearLayout>

</LinearLayout>
