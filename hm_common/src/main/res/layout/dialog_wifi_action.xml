<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minWidth="380dp"
    android:background="@drawable/hm_dialog_wifi_bg"
    android:orientation="vertical"
    android:padding="26dp">

    <!-- WiFi 标题 -->
    <TextView
        android:id="@+id/tv_action_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#333333"
        android:textSize="22sp"
        android:textStyle="bold"
        tools:text="hengmei2F-1" />

    <!-- 状态与IP提示 -->
    <TextView
        android:id="@+id/tv_action_message"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:lineSpacingMultiplier="1.2"
        android:textColor="#666666"
        android:textSize="16sp"
        tools:text="当前已连接到此网络 (192.168.111.45)" />

    <!-- 分割线 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="20dp"
        android:background="#EAEAEA" />

    <!-- 操作按钮区 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_action_cancel"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/hm_btn_secondary"
            android:minWidth="96dp"
            android:paddingHorizontal="16dp"
            android:singleLine="true"
            android:text="@string/hm_wifi_cancel"
            android:textColor="#666666"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btn_action_forget"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/hm_btn_secondary"
            android:minWidth="108dp"
            android:paddingHorizontal="16dp"
            android:singleLine="true"
            android:text="@string/hm_wifi_forget"
            android:textColor="#E53935"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btn_action_primary"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:background="@drawable/hm_btn_primary"
            android:minWidth="108dp"
            android:paddingHorizontal="16dp"
            android:singleLine="true"
            android:text="@string/hm_wifi_disconnect"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            tools:text="断开连接" />
    </LinearLayout>

</LinearLayout>
