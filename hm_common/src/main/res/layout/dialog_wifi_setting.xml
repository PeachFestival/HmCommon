<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/hm_dialog_wifi_bg"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- 顶部标题栏 -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:text="@string/hm_wifi_title"
            android:textColor="#333333"
            android:textSize="22sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Switch
                android:id="@+id/switch_wifi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="16dp"
                android:scaleX="1.25"
                android:scaleY="1.25" />

            <ImageView
                android:id="@+id/iv_refresh"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/hm_item_wifi_bg"
                android:contentDescription="@string/hm_wifi_refresh"
                android:padding="6dp"
                android:src="@drawable/hm_ic_wifi_refresh" />

            <ImageView
                android:id="@+id/iv_close"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/hm_item_wifi_bg"
                android:contentDescription="@string/hm_wifi_close"
                android:padding="6dp"
                android:src="@drawable/hm_ic_wifi_close" />
        </LinearLayout>
    </RelativeLayout>

    <!-- 分割线 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="10dp"
        android:background="#E0E0E0" />

    <!-- 扫描中进度条 -->
    <ProgressBar
        android:id="@+id/pb_scanning"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:indeterminate="true"
        android:visibility="gone" />

    <!-- 提示文本（WiFi关闭或无可用网络） -->
    <TextView
        android:id="@+id/tv_empty_tip"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:gravity="center"
        android:text="@string/hm_wifi_empty_disabled"
        android:textColor="#999999"
        android:textSize="17sp"
        android:visibility="gone" />

    <!-- WiFi 列表 -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_wifi_list"
        android:layout_width="match_parent"
        android:layout_height="360dp"
        android:fadeScrollbars="false"
        android:overScrollMode="never"
        android:scrollbars="vertical" />

</LinearLayout>
